  IDEAL       0,15      OOS     100  100,0%   26,0%   73,0%     1,0%   23,1%      4,5     0,90      89,95
  IDEAL       0,25      IS      333  100,0%   34,8%   65,2%     0,0%   33,3%     -0,3    -0,06     -19,11
  IDEAL       0,25      OOS     100  100,0%   37,0%   62,0%     1,0%   33,3%      7,3     1,47     146,99
  IDEAL       0,50      IS      333  100,0%   51,7%   47,7%     0,6%   50,0%      4,6     0,91     303,56
  IDEAL       0,50      OOS     100  100,0%   52,0%   47,0%     1,0%   50,0%      8,9     1,78     178,13
  -------------------------------------------------------------------------------------------------------
  EXECUTAVEL  0,15      IS      259   77,8%   24,7%   75,3%     0,0%   23,1%     -6,3    -1,26    -326,01
  EXECUTAVEL  0,15      OOS      77   77,0%   23,4%   76,6%     0,0%   23,1%     -6,8    -1,36    -104,53
  EXECUTAVEL  0,25      IS      259   77,8%   33,6%   66,0%     0,4%   33,3%     -9,7    -1,93    -499,93
